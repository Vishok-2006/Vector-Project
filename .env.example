# Vectora configuration. Copy to ".env" (docker: --env-file .env) and fill in the secret.
# NEVER commit the real .env file.

# =============================================================================================
# NVIDIA NIM  (required)  - get a key at https://build.nvidia.com
# =============================================================================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Chat model used to write answers. Any chat model in the NVIDIA API catalog works.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_HISTORY_MESSAGES=6

# =============================================================================================
# Embeddings - a SEPARATE model from the chat model (chat models cannot create embeddings)
# =============================================================================================
# "nvidia" (default): NIM /embeddings, nothing extra to install.
# "local": in-container sentence-transformers; requires building the image with
#          --build-arg EMBEDDINGS=local (adds ~1 GB image size and needs >= 2 GB RAM).
EMBEDDING_PROVIDER=nvidia
# Leave unset to use the provider default (nvidia/nv-embedqa-e5-v5 -> 1024 dims,
# or sentence-transformers/all-MiniLM-L6-v2 -> 384 dims).
# EMBEDDING_MODEL=
# Only needed for models this app does not know. MUST equal the model's vector size.
# EMBEDDING_DIMENSION=
# true for asymmetric retrieval models (nv-embedqa-*, e5): sends input_type passage/query.
NVIDIA_EMBEDDING_ASYMMETRIC=true
EMBEDDING_BATCH_SIZE=32
# Max words per chunk so a whole chunk fits the embedding model's context window.
# Defaults: 250 (nvidia), 150 (local).
# EMBEDDING_MAX_CHUNK_WORDS=

# =============================================================================================
# Retrieval
# =============================================================================================
RAG_TOP_K=6
# Minimum cosine similarity (0-1) for a chunk to be used as context. Raise if answers cite
# irrelevant passages; lower if relevant passages are being dropped.
RAG_MIN_SCORE=0.2

# =============================================================================================
# Qdrant (inside the container these are already correct - change only for an external Qdrant)
# =============================================================================================
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# Changing embedding model/dimension? Use a NEW collection name instead of reusing this one.
QDRANT_COLLECTION=vectora_chunks

# =============================================================================================
# App / deployment
# =============================================================================================
# Public port. Render injects PORT automatically; locally 10000 is the default.
PORT=10000
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
# Where SQLite (chats, document list) and the session signing key live. Inside the container
# this sits on the persistent /qdrant volume.
APP_DATA_DIR=/qdrant/app-data
# Optional: fixed key for signing session cookies (otherwise generated once and persisted).
# SESSION_SECRET=
# auto = Secure cookies when served over HTTPS (Render). Use "false" only for plain-http tests.
COOKIE_SECURE=auto
# Optional: protect the WHOLE site (UI + API) with a username/password prompt.
# Strongly recommended for any public deployment, because every visitor spends your NVIDIA quota.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# Only for running the UI on a different origin than the API (not needed with the Docker image).
# BACKEND_CORS_ORIGINS=http://localhost:3000
